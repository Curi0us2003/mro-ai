# ==============================================================
# AI Maintenance Voice Copilot - environment configuration
#
# Copy this file to ".env" in the PROJECT ROOT and fill in real
# values. Every variable here is read exactly once, in
# backend/config.py - no other module calls os.getenv() directly.
# ==============================================================


# --------------------------------------------------------------
# Application
# --------------------------------------------------------------

# Signs Flask's session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DEBUG=true
PORT=5000
LOG_LEVEL=INFO

SESSION_LIFETIME_HOURS=12
# Set to true once the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Serve over a self-signed HTTPS certificate (via `python -m backend.app`).
# Browsers only expose the microphone to a secure context - HTTPS, or
# http://localhost on the same machine - so this is needed for any
# technician reaching the app from another device (e.g. over the
# hangar Wi-Fi). Browsers show a one-time certificate warning to click
# through. Requires pyOpenSSL. Set to false to serve plain HTTP instead
# (fine if you're only ever testing from http://localhost).
HTTPS_ADHOC=true


# --------------------------------------------------------------
# SAP HANA Cloud
# --------------------------------------------------------------
# From your HANA Cloud instance / HDI container binding. The
# schema must already contain USERS, MANUALS, MANUAL_CHUNKS,
# MAINTENANCE_RECORDS and CONVERSATIONS - this app's runtime user
# only has DML rights and cannot create tables itself.

HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=
HANA_ENCRYPT=true


# --------------------------------------------------------------
# SAP AI Core / Generative AI Hub
# --------------------------------------------------------------
# From the service key of your "aicore" service instance:
#   clientid                       -> AICORE_CLIENT_ID
#   clientsecret                   -> AICORE_CLIENT_SECRET
#   url                            -> AICORE_AUTH_URL
#   serviceurls.AI_API_URL + "/v2" -> AICORE_BASE_URL

AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=

AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default


# --------------------------------------------------------------
# Models
# --------------------------------------------------------------
# Each must exist as a RUNNING deployment in AI Core - being
# listed in the model catalogue is not enough. Set the matching
# *_DEPLOYMENT_ID below instead of the model name to target a
# deployment directly by its 16-character ID.

AICORE_CHAT_MODEL=gpt-4.1
AICORE_EMBEDDING_MODEL=text-embedding-3-large
# Must match a RUNNING deployment's model name exactly - check
# `AI Core > Deployments` in AI Launchpad if transcription fails.
AICORE_STT_MODEL=gemini-3.5-flash

AICORE_CHAT_DEPLOYMENT_ID=
AICORE_EMBEDDING_DEPLOYMENT_ID=
AICORE_STT_DEPLOYMENT_ID=


# --------------------------------------------------------------
# Embedding Configuration
# --------------------------------------------------------------
# EMBEDDING_DIM must match the width of the REAL_VECTOR column
# on MANUAL_CHUNKS.EMBEDDING - that width cannot be changed after
# the table is created.

EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64
MIN_RELEVANCE_SCORE=0.30


# --------------------------------------------------------------
# Piper Text-to-Speech
# --------------------------------------------------------------
# Runs locally - no API key needed. Download the two voice files
# (en_US-lessac-medium.onnx + .onnx.json) from the Piper voices
# release into voices/, or point PIPER_VOICE_NAME at another one.

PIPER_VOICE_NAME=en_US-lessac-medium
PIPER_LENGTH_SCALE=1.0
PIPER_SENTENCE_SILENCE=0.35
